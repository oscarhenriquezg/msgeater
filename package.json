    "@types/archiver": "^8.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.11",
    "cfb": "^1.2.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
