{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // El CLI reutiliza los ficheros de i18n de la ventana para no acabar
    // diciendo cosas distintas de la misma señal (ver src/main/cli.ts).
    "resolveJsonModule": true,
    "noEmit": true,
    "composite": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/src/i18n/*.json", "tests/unit/**/*", "scripts/**/*", "electron.vite.config.ts"]
}
